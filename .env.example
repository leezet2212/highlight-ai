# Đổi tên file này thành .env rồi điền key của bạn.

# Google Gemini – AI xem video và viết lời bình (MIỄN PHÍ)
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs – giọng đọc cảm xúc (gói miễn phí ~10.000 ký tự/tháng)
# Lấy key tại: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Font phụ đề (phải hỗ trợ tiếng Việt)
SUBTITLE_FONT=Arial
MAX_UPLOAD_MB=500
