# Đổi tên file này thành .env rồi điền key của bạn.

# Google Gemini – AI xem video và viết lời bình (MIỄN PHÍ)
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs – giọng đọc cảm xúc (gói miễn phí ~10.000 ký tự/tháng)
# Lấy key tại: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Font phụ đề (phải hỗ trợ tiếng Việt)
SUBTITLE_FONT=Arial
MAX_UPLOAD_MB=500

# --- Khi đưa lên web ---
# Mật khẩu để vào trang (bỏ trống = không cần mật khẩu, chỉ nên dùng khi chạy trên máy mình)
APP_PASSWORD=
# Tự xoá video cũ hơn số giờ này (0 = không xoá)
JOB_TTL_HOURS=24
# Số video được xuất cùng lúc (máy chủ miễn phí nên để 1)
MAX_CONCURRENT_RENDERS=1

# --- Tốc độ xuất video ---
# auto = tự dùng card đồ hoạ (NVIDIA/Intel/AMD/Mac) nếu có, không có thì dùng CPU.
# Có thể ép: libx264 (CPU), h264_nvenc, h264_qsv, h264_amf, h264_videotoolbox
VIDEO_ENCODER=auto
# Chỉ áp dụng khi dùng CPU: ultrafast/superfast/veryfast (nhanh) ... medium/slow (đẹp hơn, chậm hơn)
VIDEO_PRESET=veryfast

# --- 👗 Video Thời Trang ---
# Mẫu Gemini tạo ảnh "AI mặc thử" (có thể cần bật thanh toán trong Google AI Studio)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Giữ dự án thời trang bao nhiêu giờ (mặc định 7 ngày)
FASHION_TTL_HOURS=168
